<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.1"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:p1="clr-namespace:RigConfiguration;assembly=Extensions"
                 xmlns:p2="clr-namespace:;assembly=Extensions"
                 xmlns:p3="clr-namespace:OpenCV.Net;assembly=OpenCV.Net"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns:cv="clr-namespace:Bonsai.Vision;assembly=Bonsai.Vision"
                 xmlns:p4="clr-namespace:Bonsai.MultiAnimalTracking;assembly=Bonsai.MultiAnimalTracking"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="WorkflowInput">
        <Name>Source1</Name>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="CameraName" />
        <Property Name="VignetteImageFileName" />
        <Property Name="Source" />
        <Property Name="Destination" />
        <Property Name="Size" />
        <Property Name="ThresholdValue" />
        <Property Name="MinArea" />
        <Property Name="MaxArea" />
        <Property Name="MinDensity" />
        <Property Name="MaxElongation" />
        <Property Name="ModelPath" />
        <Property Name="ExecutionProvider" />
        <Property Name="ThreadCount" />
        <Property Name="CudaLibraryPath" />
        <Property Name="Interval" />
        <Property Name="Phase" />
        <Property Name="CameraIndex" />
        <Property Name="EdgeBand" />
        <Property Name="FloorMargin" />
        <Property Name="VoteDistance" />
        <Property Name="RejectClass" />
        <Property Name="OutputSubject" />
        <Property Name="RegistrationCamera" />
      </Expression>
      <Expression xsi:type="rx:Defer">
        <Workflow>
          <Nodes>
            <Expression xsi:type="SubscribeSubject">
              <Name>FrameEvents</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="CameraName" />
            </Expression>
            <Expression xsi:type="rx:Condition">
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Key.Item1</Selector>
                  </Expression>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="Value" />
                  </Expression>
                  <Expression xsi:type="Equal">
                    <Operand xsi:type="WorkflowProperty" TypeArguments="p1:CameraName">
                      <Value>North</Value>
                    </Operand>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="3" Label="Source1" />
                  <Edge From="2" To="3" Label="Source2" />
                  <Edge From="3" To="4" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>SelectedCamera</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>SelectedCamera</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Merge" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:ObserveOn">
                <rx:Scheduler>TaskPoolScheduler</rx:Scheduler>
              </Combinator>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Name" DisplayName="RegistrationCamera" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>cam0</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Value</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:WithLatestFrom" />
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>CameraStreams</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>CameraStreams</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Item1.Value.Image</Selector>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="VignetteImageFileName" />
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="Extensions\NormalizedImage.bonsai">
              <VignetteImageFileName>D:\phields\config\4mmVigneting2.png</VignetteImageFileName>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>CameraStreams</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Item2</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:WithLatestFrom" />
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Source" />
              <Property Name="Destination" />
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="Size" />
            </Expression>
            <Expression xsi:type="PropertySource" TypeArguments="p2:WarpToWorld,p3:Size">
              <MemberName>Size</MemberName>
              <Value>
                <Width>0</Width>
                <Height>0</Height>
              </Value>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Size" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p2:WarpToWorld">
                <p2:Source>
                  <p2:Point2f>
                    <p2:X>374.85</p2:X>
                    <p2:Y>736.8046</p2:Y>
                  </p2:Point2f>
                  <p2:Point2f>
                    <p2:X>393.975</p2:X>
                    <p2:Y>1778.63062</p2:Y>
                  </p2:Point2f>
                  <p2:Point2f>
                    <p2:X>2189.629</p2:X>
                    <p2:Y>1765.33337</p2:Y>
                  </p2:Point2f>
                  <p2:Point2f>
                    <p2:X>2202.678</p2:X>
                    <p2:Y>754.6667</p2:Y>
                  </p2:Point2f>
                </p2:Source>
                <p2:Destination>
                  <p2:Point2f>
                    <p2:X>653.3203</p2:X>
                    <p2:Y>432.998077</p2:Y>
                  </p2:Point2f>
                  <p2:Point2f>
                    <p2:X>669</p2:X>
                    <p2:Y>1682.031</p2:Y>
                  </p2:Point2f>
                  <p2:Point2f>
                    <p2:X>2869.38281</p2:X>
                    <p2:Y>1693.13342</p2:Y>
                  </p2:Point2f>
                  <p2:Point2f>
                    <p2:X>2864.15625</p2:X>
                    <p2:Y>432.998077</p2:Y>
                  </p2:Point2f>
                </p2:Destination>
                <p2:Size>
                  <p2:Width>0</p2:Width>
                  <p2:Height>0</p2:Height>
                </p2:Size>
                <p2:Flags>Linear</p2:Flags>
                <p2:FillValue>
                  <p2:Val0>0</p2:Val0>
                  <p2:Val1>0</p2:Val1>
                  <p2:Val2>0</p2:Val2>
                  <p2:Val3>0</p2:Val3>
                </p2:FillValue>
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>CameraStreams</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Item1.Seconds</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="harp:CreateTimestamped" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>CameraStreams</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Item1.Value.Image</Selector>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="Extensions\VignetteGain.bonsai">
              <VignetteImageFileName>D:\phields\config\4mmVigneting2.png</VignetteImageFileName>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>Vignette</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:WithLatestFrom" />
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Item1,Item2</Selector>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="ThresholdValue" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p2:VignetteThreshold">
                <p2:ThresholdValue>110</p2:ThresholdValue>
                <p2:ThresholdType>BinaryInv</p2:ThresholdType>
                <p2:Size>
                  <p2:Width>4</p2:Width>
                  <p2:Height>4</p2:Height>
                </p2:Size>
                <p2:Anchor>
                  <p2:X>-1</p2:X>
                  <p2:Y>-1</p2:Y>
                </p2:Anchor>
                <p2:Shape>Rectangle</p2:Shape>
                <p2:Iterations>1</p2:Iterations>
                <p2:Operation>Open</p2:Operation>
              </Combinator>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="MinArea" />
              <Property Name="MaxArea" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="cv:FindContours">
                <cv:Mode>External</cv:Mode>
                <cv:Method>ChainApproxNone</cv:Method>
                <cv:Offset>
                  <cv:X>0</cv:X>
                  <cv:Y>0</cv:Y>
                </cv:Offset>
                <cv:MinArea>500</cv:MinArea>
                <cv:MaxArea>20000</cv:MaxArea>
              </Combinator>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="MinDensity" />
              <Property Name="MaxElongation" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p2:FilterBlobs">
                <p2:MinDensity>0.7</p2:MinDensity>
                <p2:MaxElongation>5</p2:MaxElongation>
              </Combinator>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>Contours</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="cv:BinaryRegionAnalysis" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>CameraStreams</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Item1.Value.Image</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject" TypeArguments="p3:IplImage">
              <rx:Name>Vignette</rx:Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:WithLatestFrom" />
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Item1.Item1,Item1.Item2,Item2</Selector>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="ModelPath" />
              <Property Name="ExecutionProvider" />
              <Property Name="ThreadCount" />
              <Property Name="CudaLibraryPath" />
              <Property Name="Interval" />
              <Property Name="Phase" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p2:ClassifyBlobIdentities">
                <p2:ModelPath>..\..\model\identity.onnx</p2:ModelPath>
                <p2:ExecutionProvider>Cuda</p2:ExecutionProvider>
                <p2:DeviceId>0</p2:DeviceId>
                <p2:ThreadCount>2</p2:ThreadCount>
                <p2:CudaLibraryPath>..\..\.bonsai\Libraries\cuda12</p2:CudaLibraryPath>
                <p2:Orientation>Average</p2:Orientation>
                <p2:AxisScale>2</p2:AxisScale>
                <p2:Interval>1</p2:Interval>
                <p2:Phase>4</p2:Phase>
              </Combinator>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Camera" DisplayName="CameraIndex" />
              <Property Name="EdgeBand" />
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="ImageSize" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p4:ProjectDetections">
                <p4:Camera>5</p4:Camera>
                <p4:Source>
                  <p4:Point2f>
                    <p4:X>374.85</p4:X>
                    <p4:Y>736.8046</p4:Y>
                  </p4:Point2f>
                  <p4:Point2f>
                    <p4:X>393.975</p4:X>
                    <p4:Y>1778.63062</p4:Y>
                  </p4:Point2f>
                  <p4:Point2f>
                    <p4:X>2189.629</p4:X>
                    <p4:Y>1765.33337</p4:Y>
                  </p4:Point2f>
                  <p4:Point2f>
                    <p4:X>2202.678</p4:X>
                    <p4:Y>754.6667</p4:Y>
                  </p4:Point2f>
                </p4:Source>
                <p4:Destination>
                  <p4:Point2f>
                    <p4:X>653.3203</p4:X>
                    <p4:Y>432.998077</p4:Y>
                  </p4:Point2f>
                  <p4:Point2f>
                    <p4:X>669</p4:X>
                    <p4:Y>1682.031</p4:Y>
                  </p4:Point2f>
                  <p4:Point2f>
                    <p4:X>2869.38281</p4:X>
                    <p4:Y>1693.13342</p4:Y>
                  </p4:Point2f>
                  <p4:Point2f>
                    <p4:X>2864.15625</p4:X>
                    <p4:Y>432.998077</p4:Y>
                  </p4:Point2f>
                </p4:Destination>
                <p4:ImageSize>
                  <p4:Width>0</p4:Width>
                  <p4:Height>0</p4:Height>
                </p4:ImageSize>
                <p4:EdgeBand>100</p4:EdgeBand>
              </Combinator>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Margin" DisplayName="FloorMargin" Category="Identity" />
              <Property Name="VoteDistance" Category="Identity" />
              <Property Name="RejectClass" DisplayName="RejectClass" Category="Identity" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p2:FilterObservations">
                <p2:Floor>
                  <p2:X>100</p2:X>
                  <p2:Y>100</p2:Y>
                  <p2:Width>5240</p2:Width>
                  <p2:Height>6101</p2:Height>
                </p2:Floor>
                <p2:Margin>0</p2:Margin>
                <p2:VoteDistance>0</p2:VoteDistance>
                <p2:Exclusions />
                <p2:RejectClass>4</p2:RejectClass>
                <p2:RejectScore>0.5</p2:RejectScore>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject" TypeArguments="cv:Contours">
              <rx:Name>Contours</rx:Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p2:ContoursPerspectiveTransform">
                <p2:Source>
                  <p2:Point2f>
                    <p2:X>374.85</p2:X>
                    <p2:Y>736.8046</p2:Y>
                  </p2:Point2f>
                  <p2:Point2f>
                    <p2:X>393.975</p2:X>
                    <p2:Y>1778.63062</p2:Y>
                  </p2:Point2f>
                  <p2:Point2f>
                    <p2:X>2189.629</p2:X>
                    <p2:Y>1765.33337</p2:Y>
                  </p2:Point2f>
                  <p2:Point2f>
                    <p2:X>2202.678</p2:X>
                    <p2:Y>754.6667</p2:Y>
                  </p2:Point2f>
                </p2:Source>
                <p2:Destination>
                  <p2:Point2f>
                    <p2:X>653.3203</p2:X>
                    <p2:Y>432.998077</p2:Y>
                  </p2:Point2f>
                  <p2:Point2f>
                    <p2:X>669</p2:X>
                    <p2:Y>1682.031</p2:Y>
                  </p2:Point2f>
                  <p2:Point2f>
                    <p2:X>2869.38281</p2:X>
                    <p2:Y>1693.13342</p2:Y>
                  </p2:Point2f>
                  <p2:Point2f>
                    <p2:X>2864.15625</p2:X>
                    <p2:Y>432.998077</p2:Y>
                  </p2:Point2f>
                </p2:Destination>
                <p2:Size>
                  <p2:Width>5440</p2:Width>
                  <p2:Height>6301</p2:Height>
                </p2:Size>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>CameraStreams</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Item1.Seconds</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="harp:CreateTimestamped" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:WithLatestFrom" />
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Name" DisplayName="OutputSubject" Category="Subject" />
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>cam1</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Item1</Selector>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="2" Label="Source2" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="7" To="11" Label="Source1" />
            <Edge From="8" To="9" Label="Source1" />
            <Edge From="9" To="10" Label="Source1" />
            <Edge From="10" To="11" Label="Source2" />
            <Edge From="11" To="12" Label="Source1" />
            <Edge From="13" To="14" Label="Source1" />
            <Edge From="14" To="16" Label="Source1" />
            <Edge From="15" To="16" Label="Source2" />
            <Edge From="15" To="31" Label="Source1" />
            <Edge From="16" To="19" Label="Source1" />
            <Edge From="17" To="18" Label="Source1" />
            <Edge From="18" To="19" Label="Source2" />
            <Edge From="19" To="24" Label="Source1" />
            <Edge From="20" To="24" Label="Source2" />
            <Edge From="20" To="53" Label="Source3" />
            <Edge From="20" To="57" Label="Source1" />
            <Edge From="21" To="22" Label="Source1" />
            <Edge From="22" To="23" Label="Source1" />
            <Edge From="22" To="52" Label="Source1" />
            <Edge From="23" To="24" Label="Source3" />
            <Edge From="24" To="27" Label="Source1" />
            <Edge From="25" To="26" Label="Source1" />
            <Edge From="26" To="27" Label="Source2" />
            <Edge From="27" To="28" Label="Source1" />
            <Edge From="28" To="63" Label="Source1" />
            <Edge From="29" To="30" Label="Source1" />
            <Edge From="30" To="33" Label="Source1" />
            <Edge From="31" To="32" Label="Source1" />
            <Edge From="32" To="33" Label="Source2" />
            <Edge From="33" To="34" Label="Source1" />
            <Edge From="34" To="36" Label="Source1" />
            <Edge From="35" To="36" Label="Source2" />
            <Edge From="36" To="38" Label="Source1" />
            <Edge From="37" To="38" Label="Source2" />
            <Edge From="38" To="40" Label="Source1" />
            <Edge From="39" To="40" Label="Source2" />
            <Edge From="40" To="41" Label="Source1" />
            <Edge From="41" To="42" Label="Source1" />
            <Edge From="42" To="45" Label="Source1" />
            <Edge From="43" To="44" Label="Source1" />
            <Edge From="44" To="45" Label="Source2" />
            <Edge From="45" To="47" Label="Source1" />
            <Edge From="46" To="47" Label="Source2" />
            <Edge From="47" To="48" Label="Source1" />
            <Edge From="48" To="50" Label="Source1" />
            <Edge From="49" To="50" Label="Source2" />
            <Edge From="50" To="53" Label="Source1" />
            <Edge From="51" To="53" Label="Source2" />
            <Edge From="52" To="53" Label="Source4" />
            <Edge From="53" To="55" Label="Source1" />
            <Edge From="54" To="55" Label="Source2" />
            <Edge From="55" To="58" Label="Source1" />
            <Edge From="56" To="57" Label="Source2" />
            <Edge From="57" To="58" Label="Source2" />
            <Edge From="58" To="61" Label="Source1" />
            <Edge From="59" To="60" Label="Source1" />
            <Edge From="60" To="61" Label="Source2" />
            <Edge From="61" To="62" Label="Source1" />
            <Edge From="62" To="63" Label="Source2" />
            <Edge From="63" To="65" Label="Source1" />
            <Edge From="64" To="65" Label="Source2" />
            <Edge From="65" To="66" Label="Source1" />
            <Edge From="66" To="67" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Value</Selector>
      </Expression>
      <Expression xsi:type="WorkflowOutput" />
    </Nodes>
    <Edges>
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>