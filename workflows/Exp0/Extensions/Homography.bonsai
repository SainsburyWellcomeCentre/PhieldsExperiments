<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:p1="clr-namespace:;assembly=Extensions"
                 xmlns:dsp="clr-namespace:Bonsai.Dsp;assembly=Bonsai.Dsp"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="WorkflowInput">
        <Name>Source1</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:SampleInterval">
          <rx:Interval>PT1S</rx:Interval>
        </Combinator>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="ThresholdValue" />
        <Property Name="VignetteImageFileName" />
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="IncludeWorkflow" Path="Extensions\NormalizedThreshold.bonsai">
          <VignetteImageFileName>Y:\phields\config\4mmVigneting2.png</VignetteImageFileName>
          <ThresholdValue>150</ThresholdValue>
        </Builder>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Source" />
        <Property Name="Size" />
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Destination" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:WarpPerspective">
          <p1:Source>
            <p1:Point2f>
              <p1:X>498.206238</p1:X>
              <p1:Y>405.411255</p1:Y>
            </p1:Point2f>
            <p1:Point2f>
              <p1:X>442.743744</p1:X>
              <p1:Y>1665.02844</p1:Y>
            </p1:Point2f>
            <p1:Point2f>
              <p1:X>1906.76245</p1:X>
              <p1:Y>1618.65308</p1:Y>
            </p1:Point2f>
            <p1:Point2f>
              <p1:X>1876.16248</p1:X>
              <p1:Y>478.7144</p1:Y>
            </p1:Point2f>
          </p1:Source>
          <p1:Destination>
            <p1:Point2f>
              <p1:X>100</p1:X>
              <p1:Y>100</p1:Y>
            </p1:Point2f>
            <p1:Point2f>
              <p1:X>100</p1:X>
              <p1:Y>2600</p1:Y>
            </p1:Point2f>
            <p1:Point2f>
              <p1:X>3100</p1:X>
              <p1:Y>2600</p1:Y>
            </p1:Point2f>
            <p1:Point2f>
              <p1:X>3100</p1:X>
              <p1:Y>100</p1:Y>
            </p1:Point2f>
          </p1:Destination>
          <p1:Flags>Linear</p1:Flags>
          <p1:FillValue>
            <p1:Val0>0</p1:Val0>
            <p1:Val1>0</p1:Val1>
            <p1:Val2>0</p1:Val2>
            <p1:Val3>0</p1:Val3>
          </p1:FillValue>
          <p1:Size>
            <p1:Width>3200</p1:Width>
            <p1:Height>2700</p1:Height>
          </p1:Size>
        </Combinator>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Name" />
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject">
        <Name>WestImage</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dsp:ConvertScale">
          <dsp:Depth xsi:nil="true" />
          <dsp:Scale>0.3</dsp:Scale>
          <dsp:Shift>0</dsp:Shift>
        </Combinator>
      </Expression>
      <Expression xsi:type="WorkflowOutput" />
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="3" Label="Source1" />
      <Edge From="2" To="3" Label="Source2" />
      <Edge From="3" To="6" Label="Source1" />
      <Edge From="4" To="6" Label="Source2" />
      <Edge From="5" To="6" Label="Source3" />
      <Edge From="6" To="8" Label="Source1" />
      <Edge From="7" To="8" Label="Source2" />
      <Edge From="8" To="9" Label="Source1" />
      <Edge From="9" To="10" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>