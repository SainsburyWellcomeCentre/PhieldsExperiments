<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:cv="clr-namespace:Bonsai.Vision;assembly=Bonsai.Vision"
                 xmlns:p1="clr-namespace:;assembly=Extensions"
                 xmlns:gui="clr-namespace:Bonsai.Gui;assembly=Bonsai.Gui"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="WorkflowInput">
        <Name>Source1</Name>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="ThresholdValue" />
        <Property Name="VignetteImageFileName" />
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Extensions\NormalizedThreshold.bonsai">
        <VignetteImageFileName>Y:\phields\config\4mmVigneting2.png</VignetteImageFileName>
        <ThresholdValue>154</ThresholdValue>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>threshold</Name>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="MinArea" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:FindContours">
          <cv:Mode>List</cv:Mode>
          <cv:Method>ChainApproxNone</cv:Method>
          <cv:Offset>
            <cv:X>0</cv:X>
            <cv:Y>0</cv:Y>
          </cv:Offset>
          <cv:MinArea>500</cv:MinArea>
          <cv:MaxArea xsi:nil="true" />
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>FindContours</Name>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Source" />
        <Property Name="Size" />
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Destination" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:ContoursPerspectiveTransform">
          <p1:Source>
            <p1:Point2f>
              <p1:X>498.206238</p1:X>
              <p1:Y>405.411255</p1:Y>
            </p1:Point2f>
            <p1:Point2f>
              <p1:X>442.743744</p1:X>
              <p1:Y>1665.02844</p1:Y>
            </p1:Point2f>
            <p1:Point2f>
              <p1:X>1906.76245</p1:X>
              <p1:Y>1618.65308</p1:Y>
            </p1:Point2f>
            <p1:Point2f>
              <p1:X>1876.16248</p1:X>
              <p1:Y>478.7144</p1:Y>
            </p1:Point2f>
          </p1:Source>
          <p1:Destination>
            <p1:Point2f>
              <p1:X>100</p1:X>
              <p1:Y>100</p1:Y>
            </p1:Point2f>
            <p1:Point2f>
              <p1:X>100</p1:X>
              <p1:Y>2600</p1:Y>
            </p1:Point2f>
            <p1:Point2f>
              <p1:X>3100</p1:X>
              <p1:Y>2600</p1:Y>
            </p1:Point2f>
            <p1:Point2f>
              <p1:X>3100</p1:X>
              <p1:Y>100</p1:Y>
            </p1:Point2f>
          </p1:Destination>
          <p1:Size>
            <p1:Width>0</p1:Width>
            <p1:Height>0</p1:Height>
          </p1:Size>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>WarpContours</Name>
      </Expression>
      <Expression xsi:type="rx:Visualizer">
        <Workflow>
          <Nodes>
            <Expression xsi:type="SubscribeSubject">
              <Name>Image</Name>
            </Expression>
            <Expression xsi:type="VisualizerMapping" />
            <Expression xsi:type="SubscribeSubject">
              <Name>threshold</Name>
            </Expression>
            <Expression xsi:type="VisualizerMapping" />
            <Expression xsi:type="SubscribeSubject">
              <Name>FindContours</Name>
            </Expression>
            <Expression xsi:type="VisualizerMapping" />
            <Expression xsi:type="SubscribeSubject">
              <Name>WarpContours</Name>
            </Expression>
            <Expression xsi:type="VisualizerMapping" />
            <Expression xsi:type="gui:TableLayoutPanelBuilder">
              <gui:Enabled>true</gui:Enabled>
              <gui:Visible>true</gui:Visible>
              <gui:ColumnCount>2</gui:ColumnCount>
              <gui:RowCount>2</gui:RowCount>
              <gui:ColumnStyles />
              <gui:RowStyles />
              <gui:CellSpans />
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="8" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="8" Label="Source2" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="5" To="8" Label="Source3" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="7" To="8" Label="Source4" />
            <Edge From="8" To="9" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="WorkflowOutput" />
    </Nodes>
    <Edges>
      <Edge From="0" To="2" Label="Source1" />
      <Edge From="1" To="2" Label="Source2" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="3" To="5" Label="Source1" />
      <Edge From="4" To="5" Label="Source2" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="6" To="9" Label="Source1" />
      <Edge From="7" To="9" Label="Source2" />
      <Edge From="8" To="9" Label="Source3" />
      <Edge From="9" To="10" Label="Source1" />
      <Edge From="10" To="11" Label="Source1" />
      <Edge From="11" To="12" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>