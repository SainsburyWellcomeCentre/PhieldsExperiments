<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.1"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:p1="clr-namespace:RigConfiguration;assembly=Extensions"
                 xmlns:p2="clr-namespace:;assembly=Extensions"
                 xmlns:p3="clr-namespace:OpenCV.Net;assembly=OpenCV.Net"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns:gui="clr-namespace:Bonsai.Gui;assembly=Bonsai.Gui"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="WorkflowInput">
        <Name>Source1</Name>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="MinArea" />
        <Property Name="Source" />
        <Property Name="Destination" />
        <Property Name="VignetteImageFileName" />
        <Property Name="OutputImage" />
        <Property Name="ThresholdValue" />
        <Property Name="OutputSubject" />
        <Property Name="Size" />
        <Property Name="Skip" />
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="CameraName" />
      </Expression>
      <Expression xsi:type="rx:Defer">
        <Workflow>
          <Nodes>
            <Expression xsi:type="SubscribeSubject">
              <Name>FrameEvents</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="CameraName" />
            </Expression>
            <Expression xsi:type="rx:Condition">
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Key.Item1</Selector>
                  </Expression>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="Value" />
                  </Expression>
                  <Expression xsi:type="Equal">
                    <Operand xsi:type="WorkflowProperty" TypeArguments="p1:CameraName">
                      <Value>Center</Value>
                    </Operand>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="3" Label="Source1" />
                  <Edge From="2" To="3" Label="Source2" />
                  <Edge From="3" To="4" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>SelectedCamera</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>SelectedCamera</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Merge" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:ObserveOn">
                <rx:Scheduler>TaskPoolScheduler</rx:Scheduler>
              </Combinator>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="MemberSelector">
                <Selector>Value.Image</Selector>
              </Builder>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="Combinator">
                <Combinator xsi:type="rx:SampleInterval">
                  <rx:Interval>PT0.1S</rx:Interval>
                </Combinator>
              </Builder>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Image</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Image</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="MinArea" />
              <Property Name="ThresholdValue" />
              <Property Name="VignetteImageFileName" />
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="Source" />
            </Expression>
            <Expression xsi:type="PropertySource" TypeArguments="p2:ContoursPerspectiveTransform,p3:Point2f[]">
              <MemberName>Source</MemberName>
              <Value>
                <Point2f>
                  <X>502.35</X>
                  <Y>403.916748</Y>
                </Point2f>
                <Point2f>
                  <X>441.15</X>
                  <Y>1668.44006</Y>
                </Point2f>
                <Point2f>
                  <X>1907.4</X>
                  <Y>1619.72644</Y>
                </Point2f>
                <Point2f>
                  <X>1880.625</X>
                  <Y>470.897919</Y>
                </Point2f>
              </Value>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Source" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="Destination" />
            </Expression>
            <Expression xsi:type="PropertySource" TypeArguments="p2:ContoursPerspectiveTransform,p3:Point2f[]">
              <MemberName>Destination</MemberName>
              <Value>
                <Point2f>
                  <X>100</X>
                  <Y>100</Y>
                </Point2f>
                <Point2f>
                  <X>100</X>
                  <Y>2770</Y>
                </Point2f>
                <Point2f>
                  <X>3245</X>
                  <Y>2770</Y>
                </Point2f>
                <Point2f>
                  <X>3245</X>
                  <Y>100</Y>
                </Point2f>
              </Value>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Destination" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="Size" />
            </Expression>
            <Expression xsi:type="PropertySource" TypeArguments="p2:ContoursPerspectiveTransform,p3:Size">
              <MemberName>Size</MemberName>
              <Value>
                <Width>3345</Width>
                <Height>2870</Height>
              </Value>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Size" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="harp:ConvertTimestamped">
              <Name>PointHomography</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Image</Selector>
                  </Expression>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="ThresholdValue" />
                    <Property Name="VignetteImageFileName" />
                    <Property Name="MinArea" />
                    <Property Name="Source" />
                    <Property Name="Size" />
                    <Property Name="Destination" />
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="Extensions\PointHomography.bonsai">
                    <ThresholdValue>100</ThresholdValue>
                    <VignetteImageFileName>Y:\phields\config\4mmVigneting2.png</VignetteImageFileName>
                    <MinArea>500</MinArea>
                    <Source>
                      <Point2f>
                        <X>502.35</X>
                        <Y>403.916748</Y>
                      </Point2f>
                      <Point2f>
                        <X>441.15</X>
                        <Y>1668.44006</Y>
                      </Point2f>
                      <Point2f>
                        <X>1907.4</X>
                        <Y>1619.72644</Y>
                      </Point2f>
                      <Point2f>
                        <X>1880.625</X>
                        <Y>470.897919</Y>
                      </Point2f>
                    </Source>
                    <Size>
                      <Width>3345</Width>
                      <Height>2870</Height>
                    </Size>
                    <Destination>
                      <Point2f>
                        <X>100</X>
                        <Y>100</Y>
                      </Point2f>
                      <Point2f>
                        <X>100</X>
                        <Y>2770</Y>
                      </Point2f>
                      <Point2f>
                        <X>3245</X>
                        <Y>2770</Y>
                      </Point2f>
                      <Point2f>
                        <X>3245</X>
                        <Y>100</Y>
                      </Point2f>
                    </Destination>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="3" Label="Source1" />
                  <Edge From="2" To="3" Label="Source2" />
                  <Edge From="3" To="4" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Name" DisplayName="OutputImage" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Image</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Image</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Count" DisplayName="Skip" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Skip">
                <rx:Count>50</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Repeat" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Concat" />
            </Expression>
            <Expression xsi:type="harp:ConvertTimestamped">
              <Name>ImageHomography</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Image</Selector>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="Extensions\NormalizedImage.bonsai">
                    <VignetteImageFileName>Y:\phields\config\4mmVigneting2.png</VignetteImageFileName>
                  </Expression>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="Source" />
                    <Property Name="Size" />
                    <Property Name="Destination" />
                    <Property Name="Name" />
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="Extensions\Homography.bonsai">
                    <Source>
                      <Point2f>
                        <X>502.35</X>
                        <Y>403.916748</Y>
                      </Point2f>
                      <Point2f>
                        <X>441.15</X>
                        <Y>1668.44006</Y>
                      </Point2f>
                      <Point2f>
                        <X>1907.4</X>
                        <Y>1619.72644</Y>
                      </Point2f>
                      <Point2f>
                        <X>1880.625</X>
                        <Y>470.897919</Y>
                      </Point2f>
                    </Source>
                    <Size>
                      <Width>3345</Width>
                      <Height>2870</Height>
                    </Size>
                    <Destination>
                      <Point2f>
                        <X>100</X>
                        <Y>100</Y>
                      </Point2f>
                      <Point2f>
                        <X>100</X>
                        <Y>2770</Y>
                      </Point2f>
                      <Point2f>
                        <X>3245</X>
                        <Y>2770</Y>
                      </Point2f>
                      <Point2f>
                        <X>3245</X>
                        <Y>100</Y>
                      </Point2f>
                    </Destination>
                    <Name>WestImage</Name>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="2" To="4" Label="Source1" />
                  <Edge From="3" To="4" Label="Source2" />
                  <Edge From="4" To="5" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:WithLatestFrom" />
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Name" DisplayName="OutputSubject" Category="Subject" />
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>cam0</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Item2</Selector>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="rx:Visualizer">
                <Workflow>
                  <Nodes>
                    <Expression xsi:type="SubscribeSubject">
                      <Name>Image</Name>
                    </Expression>
                    <Expression xsi:type="VisualizerMapping" />
                    <Expression xsi:type="SubscribeSubject">
                      <Name>threshold</Name>
                    </Expression>
                    <Expression xsi:type="VisualizerMapping" />
                    <Expression xsi:type="SubscribeSubject">
                      <Name>FindContours</Name>
                    </Expression>
                    <Expression xsi:type="VisualizerMapping" />
                    <Expression xsi:type="SubscribeSubject">
                      <Name>BinaryRegionanalysis</Name>
                    </Expression>
                    <Expression xsi:type="VisualizerMapping" />
                    <Expression xsi:type="gui:TableLayoutPanelBuilder">
                      <gui:Enabled>true</gui:Enabled>
                      <gui:Visible>true</gui:Visible>
                      <gui:ColumnCount>2</gui:ColumnCount>
                      <gui:RowCount>2</gui:RowCount>
                      <gui:ColumnStyles />
                      <gui:RowStyles />
                      <gui:CellSpans />
                    </Expression>
                    <Expression xsi:type="VisualizerMapping" />
                    <Expression xsi:type="WorkflowInput">
                      <Name>Source1</Name>
                    </Expression>
                    <Expression xsi:type="VisualizerMapping" />
                    <Expression xsi:type="gui:TableLayoutPanelBuilder">
                      <gui:Enabled>true</gui:Enabled>
                      <gui:Visible>true</gui:Visible>
                      <gui:ColumnCount>1</gui:ColumnCount>
                      <gui:RowCount>2</gui:RowCount>
                      <gui:ColumnStyles />
                      <gui:RowStyles />
                      <gui:CellSpans />
                    </Expression>
                    <Expression xsi:type="WorkflowOutput" />
                  </Nodes>
                  <Edges>
                    <Edge From="0" To="1" Label="Source1" />
                    <Edge From="1" To="8" Label="Source1" />
                    <Edge From="2" To="3" Label="Source1" />
                    <Edge From="3" To="8" Label="Source2" />
                    <Edge From="4" To="5" Label="Source1" />
                    <Edge From="5" To="8" Label="Source3" />
                    <Edge From="6" To="7" Label="Source1" />
                    <Edge From="7" To="8" Label="Source4" />
                    <Edge From="8" To="9" Label="Source1" />
                    <Edge From="9" To="12" Label="Source1" />
                    <Edge From="10" To="11" Label="Source1" />
                    <Edge From="11" To="12" Label="Source2" />
                    <Edge From="12" To="13" Label="Source1" />
                  </Edges>
                </Workflow>
              </Builder>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="2" Label="Source2" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="7" To="8" Label="Source1" />
            <Edge From="8" To="9" Label="Source1" />
            <Edge From="9" To="10" Label="Source1" />
            <Edge From="11" To="22" Label="Source1" />
            <Edge From="12" To="22" Label="Source2" />
            <Edge From="13" To="14" Label="Source1" />
            <Edge From="14" To="15" Label="Source1" />
            <Edge From="15" To="22" Label="Source3" />
            <Edge From="15" To="32" Label="Source3" />
            <Edge From="16" To="17" Label="Source1" />
            <Edge From="17" To="18" Label="Source1" />
            <Edge From="18" To="22" Label="Source4" />
            <Edge From="18" To="32" Label="Source4" />
            <Edge From="19" To="20" Label="Source1" />
            <Edge From="20" To="21" Label="Source1" />
            <Edge From="21" To="22" Label="Source5" />
            <Edge From="21" To="32" Label="Source5" />
            <Edge From="22" To="33" Label="Source1" />
            <Edge From="23" To="32" Label="Source1" />
            <Edge From="24" To="25" Label="Source1" />
            <Edge From="25" To="31" Label="Source1" />
            <Edge From="26" To="28" Label="Source1" />
            <Edge From="27" To="28" Label="Source2" />
            <Edge From="28" To="29" Label="Source1" />
            <Edge From="29" To="30" Label="Source1" />
            <Edge From="30" To="31" Label="Source2" />
            <Edge From="31" To="32" Label="Source2" />
            <Edge From="32" To="33" Label="Source2" />
            <Edge From="33" To="35" Label="Source1" />
            <Edge From="34" To="35" Label="Source2" />
            <Edge From="35" To="36" Label="Source1" />
            <Edge From="36" To="37" Label="Source1" />
            <Edge From="37" To="38" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Value</Selector>
      </Expression>
      <Expression xsi:type="WorkflowOutput" />
    </Nodes>
    <Edges>
      <Edge From="1" To="3" Label="Source1" />
      <Edge From="2" To="3" Label="Source2" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>