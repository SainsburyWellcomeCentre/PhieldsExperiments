<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.1"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:p1="clr-namespace:RigConfiguration;assembly=Extensions"
                 xmlns:p2="clr-namespace:;assembly=Extensions"
                 xmlns:p3="clr-namespace:OpenCV.Net;assembly=OpenCV.Net"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns:gui="clr-namespace:Bonsai.Gui;assembly=Bonsai.Gui"
                 xmlns:cv="clr-namespace:Bonsai.Vision;assembly=Bonsai.Vision"
                 xmlns:p4="clr-namespace:Bonsai.MultiAnimalTracking;assembly=Bonsai.MultiAnimalTracking"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="WorkflowInput">
        <Name>Source1</Name>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="MinArea" />
        <Property Name="MinDensity" />
        <Property Name="MaxElongation" />
        <Property Name="Source" />
        <Property Name="Destination" />
        <Property Name="VignetteImageFileName" />
        <Property Name="OutputImage" />
        <Property Name="ThresholdValue" />
        <Property Name="OutputSubject" />
        <Property Name="Size" />
        <Property Name="Skip" />
        <Property Name="MaxArea" />
        <Property Name="ModelPath" />
        <Property Name="ExecutionProvider" />
        <Property Name="ThreadCount" />
        <Property Name="CudaLibraryPath" />
        <Property Name="ClassifyInterval" />
        <Property Name="ClassifyPhase" />
        <Property Name="CameraIndex" />
        <Property Name="EdgeBand" />
        <Property Name="FloorMargin" />
        <Property Name="VoteDistance" />
        <Property Name="ObservationSubject" />
        <Property Name="RejectClass" />
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="CameraName" />
      </Expression>
      <Expression xsi:type="rx:Defer">
        <Workflow>
          <Nodes>
            <Expression xsi:type="SubscribeSubject">
              <Name>FrameEvents</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="CameraName" />
            </Expression>
            <Expression xsi:type="rx:Condition">
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Key.Item1</Selector>
                  </Expression>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="Value" />
                  </Expression>
                  <Expression xsi:type="Equal">
                    <Operand xsi:type="WorkflowProperty" TypeArguments="p1:CameraName">
                      <Value>North</Value>
                    </Operand>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="3" Label="Source1" />
                  <Edge From="2" To="3" Label="Source2" />
                  <Edge From="3" To="4" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>SelectedCamera</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>SelectedCamera</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Merge" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:ObserveOn">
                <rx:Scheduler>TaskPoolScheduler</rx:Scheduler>
              </Combinator>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="MemberSelector">
                <Selector>Value.Image</Selector>
              </Builder>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="Combinator">
                <Combinator xsi:type="rx:SampleInterval">
                  <rx:Interval>PT0.1S</rx:Interval>
                </Combinator>
              </Builder>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Image</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Blobs</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="Source" />
            </Expression>
            <Expression xsi:type="PropertySource" TypeArguments="p2:ContoursPerspectiveTransform,p3:Point2f[]">
              <MemberName>Source</MemberName>
              <Value>
                <Point2f>
                  <X>58.65</X>
                  <Y>550.0575</Y>
                </Point2f>
                <Point2f>
                  <X>66.3</X>
                  <Y>1631.905</Y>
                </Point2f>
                <Point2f>
                  <X>2204.475</X>
                  <Y>1613.637</Y>
                </Point2f>
                <Point2f>
                  <X>2203.2</X>
                  <Y>570.3548</Y>
                </Point2f>
              </Value>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Source" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="Destination" />
            </Expression>
            <Expression xsi:type="PropertySource" TypeArguments="p2:ContoursPerspectiveTransform,p3:Point2f[]">
              <MemberName>Destination</MemberName>
              <Value>
                <Point2f>
                  <X>290</X>
                  <Y>210</Y>
                </Point2f>
                <Point2f>
                  <X>290</X>
                  <Y>1490</Y>
                </Point2f>
                <Point2f>
                  <X>2871</X>
                  <Y>1490</Y>
                </Point2f>
                <Point2f>
                  <X>2871</X>
                  <Y>210</Y>
                </Point2f>
              </Value>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Destination" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="Size" />
            </Expression>
            <Expression xsi:type="PropertySource" TypeArguments="p2:ContoursPerspectiveTransform,p3:Size">
              <MemberName>Size</MemberName>
              <Value>
                <Width>3345</Width>
                <Height>2870</Height>
              </Value>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Size" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="harp:ConvertTimestamped">
              <Name>PointHomography</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item1</Selector>
                  </Expression>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="Source" />
                    <Property Name="Size" />
                    <Property Name="Destination" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="p2:ContoursPerspectiveTransform">
                      <p2:Source>
                        <p2:Point2f>
                          <p2:X>58.65</p2:X>
                          <p2:Y>550.0575</p2:Y>
                        </p2:Point2f>
                        <p2:Point2f>
                          <p2:X>66.3</p2:X>
                          <p2:Y>1631.905</p2:Y>
                        </p2:Point2f>
                        <p2:Point2f>
                          <p2:X>2204.475</p2:X>
                          <p2:Y>1613.637</p2:Y>
                        </p2:Point2f>
                        <p2:Point2f>
                          <p2:X>2203.2</p2:X>
                          <p2:Y>570.3548</p2:Y>
                        </p2:Point2f>
                      </p2:Source>
                      <p2:Destination>
                        <p2:Point2f>
                          <p2:X>290</p2:X>
                          <p2:Y>210</p2:Y>
                        </p2:Point2f>
                        <p2:Point2f>
                          <p2:X>290</p2:X>
                          <p2:Y>1490</p2:Y>
                        </p2:Point2f>
                        <p2:Point2f>
                          <p2:X>2871</p2:X>
                          <p2:Y>1490</p2:Y>
                        </p2:Point2f>
                        <p2:Point2f>
                          <p2:X>2871</p2:X>
                          <p2:Y>210</p2:Y>
                        </p2:Point2f>
                      </p2:Destination>
                      <p2:Size>
                        <p2:Width>3345</p2:Width>
                        <p2:Height>2870</p2:Height>
                      </p2:Size>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="3" Label="Source1" />
                  <Edge From="2" To="3" Label="Source2" />
                  <Edge From="3" To="4" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Name" DisplayName="OutputImage" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Image</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Image</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Count" DisplayName="Skip" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Skip">
                <rx:Count>50</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Repeat" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Concat" />
            </Expression>
            <Expression xsi:type="harp:ConvertTimestamped">
              <Name>ImageHomography</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Image</Selector>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="Extensions\NormalizedImage.bonsai">
                    <VignetteImageFileName>Y:\phields\config\4mmVigneting2.png</VignetteImageFileName>
                  </Expression>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="Source" />
                    <Property Name="Size" />
                    <Property Name="Destination" />
                    <Property Name="Name" />
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="Extensions\Homography.bonsai">
                    <Source>
                      <Point2f>
                        <X>58.65</X>
                        <Y>550.0575</Y>
                      </Point2f>
                      <Point2f>
                        <X>66.3</X>
                        <Y>1631.905</Y>
                      </Point2f>
                      <Point2f>
                        <X>2204.475</X>
                        <Y>1613.637</Y>
                      </Point2f>
                      <Point2f>
                        <X>2203.2</X>
                        <Y>570.3548</Y>
                      </Point2f>
                    </Source>
                    <Size>
                      <Width>3345</Width>
                      <Height>2870</Height>
                    </Size>
                    <Destination>
                      <Point2f>
                        <X>290</X>
                        <Y>210</Y>
                      </Point2f>
                      <Point2f>
                        <X>290</X>
                        <Y>1490</Y>
                      </Point2f>
                      <Point2f>
                        <X>2871</X>
                        <Y>1490</Y>
                      </Point2f>
                      <Point2f>
                        <X>2871</X>
                        <Y>210</Y>
                      </Point2f>
                    </Destination>
                    <Name>NorthImage</Name>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="2" To="4" Label="Source1" />
                  <Edge From="3" To="4" Label="Source2" />
                  <Edge From="4" To="5" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:WithLatestFrom" />
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Name" DisplayName="OutputSubject" Category="Subject" />
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>cam1</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Item2</Selector>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="rx:Visualizer">
                <Workflow>
                  <Nodes>
                    <Expression xsi:type="SubscribeSubject">
                      <Name>Image</Name>
                    </Expression>
                    <Expression xsi:type="VisualizerMapping" />
                    <Expression xsi:type="SubscribeSubject">
                      <Name>threshold</Name>
                    </Expression>
                    <Expression xsi:type="VisualizerMapping" />
                    <Expression xsi:type="SubscribeSubject">
                      <Name>FindContours</Name>
                    </Expression>
                    <Expression xsi:type="VisualizerMapping" />
                    <Expression xsi:type="SubscribeSubject">
                      <Name>BinaryRegionanalysis</Name>
                    </Expression>
                    <Expression xsi:type="VisualizerMapping" />
                    <Expression xsi:type="gui:TableLayoutPanelBuilder">
                      <gui:Enabled>true</gui:Enabled>
                      <gui:Visible>true</gui:Visible>
                      <gui:ColumnCount>2</gui:ColumnCount>
                      <gui:RowCount>2</gui:RowCount>
                      <gui:ColumnStyles />
                      <gui:RowStyles />
                      <gui:CellSpans />
                    </Expression>
                    <Expression xsi:type="VisualizerMapping" />
                    <Expression xsi:type="WorkflowInput">
                      <Name>Source1</Name>
                    </Expression>
                    <Expression xsi:type="VisualizerMapping" />
                    <Expression xsi:type="gui:TableLayoutPanelBuilder">
                      <gui:Enabled>true</gui:Enabled>
                      <gui:Visible>true</gui:Visible>
                      <gui:ColumnCount>1</gui:ColumnCount>
                      <gui:RowCount>2</gui:RowCount>
                      <gui:ColumnStyles />
                      <gui:RowStyles />
                      <gui:CellSpans />
                    </Expression>
                    <Expression xsi:type="WorkflowOutput" />
                  </Nodes>
                  <Edges>
                    <Edge From="0" To="1" Label="Source1" />
                    <Edge From="1" To="8" Label="Source1" />
                    <Edge From="2" To="3" Label="Source1" />
                    <Edge From="3" To="8" Label="Source2" />
                    <Edge From="4" To="5" Label="Source1" />
                    <Edge From="5" To="8" Label="Source3" />
                    <Edge From="6" To="7" Label="Source1" />
                    <Edge From="7" To="8" Label="Source4" />
                    <Edge From="8" To="9" Label="Source1" />
                    <Edge From="9" To="12" Label="Source1" />
                    <Edge From="10" To="11" Label="Source1" />
                    <Edge From="11" To="12" Label="Source2" />
                    <Edge From="12" To="13" Label="Source1" />
                  </Edges>
                </Workflow>
              </Builder>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
            <Expression xsi:type="SubscribeSubject">
              <Name>Blobs</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="ModelPath" Category="Identity" />
              <Property Name="ExecutionProvider" Category="Identity" />
              <Property Name="ThreadCount" Category="Identity" />
              <Property Name="CudaLibraryPath" Category="Identity" />
              <Property Name="Interval" DisplayName="ClassifyInterval" Category="Identity" />
              <Property Name="Phase" DisplayName="ClassifyPhase" Category="Identity" />
            </Expression>
            <Expression xsi:type="harp:ConvertTimestamped">
              <Name>Identities</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item1</Selector>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="cv:BinaryRegionAnalysis" />
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item2</Selector>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item3</Selector>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip" />
                  </Expression>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="ModelPath" />
                    <Property Name="ExecutionProvider" />
                    <Property Name="ThreadCount" />
                    <Property Name="CudaLibraryPath" />
                    <Property Name="Interval" />
                    <Property Name="Phase" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="p2:ClassifyBlobIdentities">
                      <p2:ModelPath>..\..\model\identity.onnx</p2:ModelPath>
                      <p2:ExecutionProvider>Cuda</p2:ExecutionProvider>
                      <p2:DeviceId>0</p2:DeviceId>
                      <p2:ThreadCount>2</p2:ThreadCount>
                      <p2:CudaLibraryPath>..\..\.bonsai\Libraries\cuda12</p2:CudaLibraryPath>
                      <p2:Orientation>Average</p2:Orientation>
                      <p2:AxisScale>2</p2:AxisScale>
                      <p2:Interval>1</p2:Interval>
                      <p2:Phase>4</p2:Phase>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="0" To="3" Label="Source1" />
                  <Edge From="0" To="4" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="2" To="5" Label="Source1" />
                  <Edge From="3" To="5" Label="Source2" />
                  <Edge From="4" To="5" Label="Source3" />
                  <Edge From="5" To="7" Label="Source1" />
                  <Edge From="6" To="7" Label="Source2" />
                  <Edge From="7" To="8" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Value,Seconds</Selector>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Camera" DisplayName="CameraIndex" Category="Identity" />
              <Property Name="EdgeBand" Category="Identity" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p4:ProjectDetections">
                <p4:Camera>5</p4:Camera>
                <p4:Source>
                  <p4:Point2f>
                    <p4:X>58.65</p4:X>
                    <p4:Y>550.0575</p4:Y>
                  </p4:Point2f>
                  <p4:Point2f>
                    <p4:X>66.3</p4:X>
                    <p4:Y>1631.905</p4:Y>
                  </p4:Point2f>
                  <p4:Point2f>
                    <p4:X>2204.475</p4:X>
                    <p4:Y>1613.637</p4:Y>
                  </p4:Point2f>
                  <p4:Point2f>
                    <p4:X>2203.2</p4:X>
                    <p4:Y>570.3548</p4:Y>
                  </p4:Point2f>
                </p4:Source>
                <p4:Destination>
                  <p4:Point2f>
                    <p4:X>290</p4:X>
                    <p4:Y>210</p4:Y>
                  </p4:Point2f>
                  <p4:Point2f>
                    <p4:X>290</p4:X>
                    <p4:Y>1490</p4:Y>
                  </p4:Point2f>
                  <p4:Point2f>
                    <p4:X>2871</p4:X>
                    <p4:Y>1490</p4:Y>
                  </p4:Point2f>
                  <p4:Point2f>
                    <p4:X>2871</p4:X>
                    <p4:Y>210</p4:Y>
                  </p4:Point2f>
                </p4:Destination>
                <p4:ImageSize>
                  <p4:Width>0</p4:Width>
                  <p4:Height>0</p4:Height>
                </p4:ImageSize>
                <p4:EdgeBand>100</p4:EdgeBand>
              </Combinator>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Margin" DisplayName="FloorMargin" Category="Identity" />
              <Property Name="VoteDistance" Category="Identity" />
              <Property Name="RejectClass" DisplayName="RejectClass" Category="Identity" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p2:FilterObservations">
                <p2:Floor>
                  <p2:X>100</p2:X>
                  <p2:Y>100</p2:Y>
                  <p2:Width>3145</p2:Width>
                  <p2:Height>2670</p2:Height>
                </p2:Floor>
                <p2:Margin>0</p2:Margin>
                <p2:VoteDistance>0</p2:VoteDistance>
                <p2:Exclusions />
                <p2:RejectClass>-1</p2:RejectClass>
                <p2:RejectScore>0.5</p2:RejectScore>
              </Combinator>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Name" DisplayName="ObservationSubject" Category="Identity" />
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>obs1</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Image</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="VignetteImageFileName" />
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="Extensions\VignetteGain.bonsai">
              <VignetteImageFileName>Y:\phields\config\4mmVigneting2.png</VignetteImageFileName>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:WithLatestFrom" />
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="MinArea" />
              <Property Name="MinDensity" />
              <Property Name="MaxElongation" />
              <Property Name="ThresholdValue" />
              <Property Name="MaxArea" />
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>BlobDetection</Name>
              <Description>The blobs of each frame, found once for both branches: the frame is paired with the vignette gain map before anything is split, so a frame dropped while the gain map loads is dropped from both and the timestamps stay aligned.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item1.Value.Image,Item2</Selector>
                  </Expression>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="ThresholdValue" />
                    <Property Name="MinArea" />
                    <Property Name="MaxArea" />
                    <Property Name="MinDensity" />
                    <Property Name="MaxElongation" />
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="Extensions\BlobDetection.bonsai">
                    <ThresholdValue>100</ThresholdValue>
                    <MinArea>500</MinArea>
                    <MaxArea>20000</MaxArea>
                    <MinDensity>0.7</MinDensity>
                    <MaxElongation>5</MaxElongation>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item1.Value.Image</Selector>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item2</Selector>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip" />
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item1.Seconds</Selector>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="harp:CreateTimestamped" />
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
