                  <Expression xsi:type="Disable">
                    <Builder xsi:type="io:CsvWriter">
                      <io:FileName>tracks.csv</io:FileName>
                      <io:Append>false</io:Append>
                      <io:Overwrite>true</io:Overwrite>
                      <io:Suffix>Timestamp</io:Suffix>
                      <io:IncludeHeader>true</io:IncludeHeader>
                    </Builder>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>IdentityTracking</Name>
                    <Description>Tracks the animals on the floor from the observations the four side cameras multicast to obs1-obs4 and gives each one an identity from the votes of every camera that sees it.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>obs1</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>obs2</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>obs3</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>obs4</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Zip" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:ObserveOn">
                            <rx:Scheduler>TaskPoolScheduler</rx:Scheduler>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="p6:TrackAnimalIdentities">
                            <p6:AnimalCount>4</p6:AnimalCount>
                            <p6:ReferenceArea>0</p6:ReferenceArea>
                            <p6:ConfidenceThreshold>0.6</p6:ConfidenceThreshold>
                            <p6:MinimumQuality>0.05</p6:MinimumQuality>
                            <p6:MeasurementNoise>10</p6:MeasurementNoise>
                            <p6:AccelerationNoise>1000</p6:AccelerationNoise>
                            <p6:InitialSpeedNoise>200</p6:InitialSpeedNoise>
                            <p6:GateThreshold>9.21</p6:GateThreshold>
                            <p6:MaximumDistance>250</p6:MaximumDistance>
                            <p6:LostSpeed>200</p6:LostSpeed>
                            <p6:RevivalDelay>2</p6:RevivalDelay>
                            <p6:MergeFactor>3</p6:MergeFactor>
                            <p6:SmallFactor>0.5</p6:SmallFactor>
                            <p6:JoinOverlap>0.5</p6:JoinOverlap>
                            <p6:ClusterDistance>60</p6:ClusterDistance>
                            <p6:FrameRate>50</p6:FrameRate>
                            <p6:HeadingSpeed>50</p6:HeadingSpeed>
                            <p6:ClassNames>animal_0,animal_1,animal_2,animal_3,other</p6:ClassNames>
                            <p6:Identities />
                            <p6:VoteHalfLife>1</p6:VoteHalfLife>
                            <p6:VoteMargin>4</p6:VoteMargin>
                            <p6:MinimumVoteMass>2</p6:MinimumVoteMass>
                            <p6:VoteIsolation>80</p6:VoteIsolation>
                            <p6:VoteAreaFactor>1.3</p6:VoteAreaFactor>
                            <p6:VoteMinimumSpeed>25</p6:VoteMinimumSpeed>
                            <p6:SlowVoteWeight>1</p6:SlowVoteWeight>
                            <p6:Combination>Mean</p6:Combination>
                            <p6:ForgetAfter>2</p6:ForgetAfter>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="4" Label="Source1" />
                        <Edge From="1" To="4" Label="Source2" />
                        <Edge From="2" To="4" Label="Source3" />
                        <Edge From="3" To="4" Label="Source4" />
                        <Edge From="4" To="5" Label="Source1" />
                        <Edge From="5" To="6" Label="Source1" />
                        <Edge From="6" To="7" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
