                    <rx:Name>CameraControllerEvents</rx:Name>
                  </Expression>
                  <Expression xsi:type="rx:ReplaySubject" TypeArguments="p3:IGroupedObservable(p1:CameraTriggerSource,harp:Timestamped(p2:CameraEvents))">
                    <rx:Name>Triggers</rx:Name>
