                                  </Combinator>
                                </Expression>
                                <Expression xsi:type="Combinator">
                                  <Combinator xsi:type="StringProperty">
                                    <Value>D:\phields\data\raw\PHIELDSCRADL01\social_0.0\2026-10-17T131702Z\East\East_2026-10-19T14-00-00.avi</Value>
                                  </Combinator>
